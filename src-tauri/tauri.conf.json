{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawdio",
  "version": "0.1.0",
  "identifier": "io.github.penguinpants.clawdio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' thumb: http://thumb.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Dr. Claw Development",
    "copyright": "Copyright (c) 2026 Dr. Claw Development",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/Penguin-Pants/Clawdio",
    "category": "Music",
    "shortDescription": "Minimalist local music player",
    "longDescription": "A lightweight, portable, local-first music player for MP3, WAV and OGG files.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_LICENSES_RUST.html": "THIRD_PARTY_LICENSES_RUST.html",
      "../THIRD_PARTY_LICENSES_WEB.txt": "THIRD_PARTY_LICENSES_WEB.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libasound2 | libasound2t64"],
        "desktopTemplate": "clawdio.desktop"
      },
      "appimage": {
        "files": {
          "usr/share/licenses/clawdio/LGPL-2.1.txt": "../licenses/LGPL-2.1.txt",
          "usr/share/licenses/clawdio/LGPL-3.0.txt": "../licenses/LGPL-3.0.txt",
          "usr/share/licenses/clawdio/GPL-3.0.txt": "../licenses/GPL-3.0.txt"
        }
      }
    }
  }
}
